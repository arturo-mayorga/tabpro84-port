# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-mondrianwifi
pkgdesc="Samsung Galaxy Tab Pro 8.4 (Wi-Fi)"
pkgver=0.1
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-msm8974
	mkbootimg
	postmarketos-base
	soc-qcom-msm8974
"
# Adreno 330 needs a330_pfp.fw / a330_pm4.fw for the GPU to come up at all,
# and wcn36xx needs this unit's own WCNSS calibration, which only exists on
# the device -- msm-firmware-loader lifts it out of the vendor partitions.
depends="$depends
	linux-firmware-qcom
	msm-firmware-loader
"
makedepends="devicepkg-dev"
source="deviceinfo"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

sha512sums="
05b93f8471fd13dc563e15e49a9701e866432fcb270f65f2bf22d6cd15890c4918753d4b75d44246f661c0dfc61effc4d855226be343e55c345abea4e06af390  deviceinfo
"
