2955e959961bd5bff9fe0a286bc0cdcf3aee4bd4cbe452daaa8096aedf5de0da62fd5bee8de166edb5eedf7acd9c004696eff6d5a8713bc0ee018cc0443eff48  config-postmarketos-qcom-msm8974.armv7
0a9e31e1a7c93d4865ac5cdddbf44d352a7554e067d755c0efa4c90e1bf5eef151d037f6072ef87863b2473f95b6a001bcf15bc35893777519ed1bd3e7e05191  0001-add-samsung-mondrianwifi.patch
"
