612b31461b38dde86ea8b97ca0612a7be3818b9cf3c06d32bc87c82cf1621fbdfd0b33e09445712430afca1453f8c4111f0538384750cc7bf2e3ea18f5dc6552  config-postmarketos-qcom-msm8974.armv7
