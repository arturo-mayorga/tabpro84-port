835b901b7ad8e23ca0e220e37c913f773b1ea9b48b69408b6abf5a26e1d499472ea86ba704d122dcd29193135022e6d7ebd397d6ba29d9b8bc689a26a2ddbd45  config-postmarketos-qcom-msm8974.armv7
4f109fc67ddf86ed6a5bb8770b2a98ebc968ad825a4656c95e33709a169ee0b6676c2af31d66cefa5bcef1d10ec3e6870ba89e6b1b4a03cf64bb7d3b62b3f3ab  0001-add-samsung-mondrianwifi.patch
