2b9bed77b20b3abb83e60d67fc8b733d3937c47b344450890acb6bebd49d7ff3275506f92c1db41a7ab0d7b2fa84289ec2530657af215e02c9a30ef23219331f  config-postmarketos-qcom-msm8974.armv7
9bf36e01c460423274498b5d4288e2155a79caf3be0036ad79ed2b9fe85491350c44978b7dcb7055345577be6b7fbf296172b8dc4ad7e428be60f063bf72e138  0001-add-samsung-mondrianwifi.patch
"
