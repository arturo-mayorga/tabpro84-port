+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,r63319.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung 1600x2560 dual-DSI panel with Renesas R63319 controller
+
+maintainers:
+  - Arturo Mayorga <arturo@mayorga.io>
+
+description:
+  A 1600x2560 60Hz video mode panel driven over two DSI links, each carrying
+  one 800x2560 half. Found in the Samsung Galaxy Tab Pro 8.4 (SM-T320). Both
+  halves share a single reset and a single enable line.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,r63319-tabpro84
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: Panel power supply (3.3V)
+
+  vddio-supply:
+    description: I/O and interface supply (1.8V)
+
+  reset-gpios: true
+  enable-gpios: true
+  backlight: true
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Primary DSI input, drives the right half of the panel
+
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Secondary DSI input, drives the left half of the panel. Optional -
+          when absent the panel is driven as a single link at 800x2560.
+
+    required:
+      - port@0
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vddio-supply
+  - reset-gpios
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,r63319-tabpro84";
+            reg = <0>;
+
+            vdd-supply = <&pm8941_l22>;
+            vddio-supply = <&pm8941_l12>;
+
+            reset-gpios = <&pm8941_gpios 9 GPIO_ACTIVE_LOW>;
+            enable-gpios = <&pm8941_gpios 14 GPIO_ACTIVE_HIGH>;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+                    panel_in0: endpoint {
+                        remote-endpoint = <&mdss_dsi0_out>;
+                    };
+                };
+
+                port@1 {
+                    reg = <1>;
+                    panel_in1: endpoint {
+                        remote-endpoint = <&mdss_dsi1_out>;
+                    };
+                };
+            };
+        };
+    };
+...
