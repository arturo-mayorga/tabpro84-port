+/*
+ * Split display: which CTL has to flush this plane's hwpipe(s). A plane
+ * across the seam has one on each side; one wholly on the right belongs
+ * to the right CTL alone.
+ */
+void mdp5_plane_get_flush_split(struct drm_plane *plane, u32 mixer_width,
+				u32 *left, u32 *right)
+{
+	struct mdp5_plane_state *pstate = to_mdp5_plane_state(plane->state);
+
+	*left = *right = 0;
+
+	if (WARN_ON(!pstate->hwpipe))
+		return;
+
+	if (pstate->r_hwpipe) {
+		*left = pstate->hwpipe->flush_mask;
+		*right = pstate->r_hwpipe->flush_mask;
+	} else if (plane->state->crtc_x >= (int)mixer_width) {
+		*right = pstate->hwpipe->flush_mask;
+	} else {
+		*left = pstate->hwpipe->flush_mask;
+	}
+}
